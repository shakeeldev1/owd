# Server
PORT=5000
MONGODB_URI=mongodb://localhost:27017/alfursan-oud
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# SkipCash
# Preferred: Key ID from SkipCash dashboard (Card Checkout key id)
SKIPCASH_KEY_ID=your_skipcash_key_id
# Optional legacy alias (use only one of these)
# SKIPCASH_CLIENT_ID=your_skipcash_client_id

# Preferred API endpoint (service will also try common fallback endpoints)
SKIPCASH_API_URL=https://api.skipcash.app/api/v1/payments

# Primary key secret
SKIPCASH_SECRET=your_primary_key_secret

# Optional: multiple key secrets for key rotation/fallback (comma or newline separated)
# SKIPCASH_SECRETS=secret_one,secret_two

# Webhook verification key.
# If SkipCash sends this value in x-webhook-key / webhook-key / Authorization, webhook is accepted.
SKIPCASH_WEBHOOK_KEY=your_webhook_key

# Optional: explicit public webhook callback URL for local development (for example ngrok)
# If set, this is used instead of BACKEND_URL to build webhook callback.
# SKIPCASH_WEBHOOK_URL=https://your-public-url.ngrok-free.app/api/orders/skipcash/webhook

# Optional: explicit public return URLs used when FRONTEND_URL is localhost
# SKIPCASH_SUCCESS_URL=https://your-public-frontend.ngrok-free.app/checkout/skipcash/success
# SKIPCASH_CANCEL_URL=https://your-public-frontend.ngrok-free.app/checkout/skipcash/cancel

# Optional: allow multiple webhook keys (comma or newline separated)
# SKIPCASH_WEBHOOK_KEYS=webhook_key_one,webhook_key_two

# WhatsApp configuration
# Preferred env names use WHATSAPP_*; MESSAGING_* aliases are still accepted for backward compatibility.
WHATSAPP_API_URL=https://custom2.waghl.com/
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_SENDER=your_whatsapp_sender
WHATSAPP_NUMBER=97471378000
# Optional aliases supported by the backend:
# MESSAGING_API_URL=https://custom2.waghl.com/
# MESSAGING_API_KEY=your_whatsapp_api_key
# MESSAGING_SENDER=your_whatsapp_sender
# MESSAGING_DEFAULT_NUMBER=97471378000
# MESSAGING_MEDIA_API_URL=https://custom2.waghl.com/send-media
# WHATSAPP_MEDIA_API_URL=https://custom2.waghl.com/send-media
# WHATSAPP_BASE_URL=https://custom2.waghl.com/
# WhatsApp send timeout in milliseconds
# MESSAGING_TIMEOUT_MS=12000
# Toggle WhatsApp sending on/off
# MESSAGING_ENABLED=true

# Additional WhatsApp admin recipient numbers (comma, semicolon or newline separated)
# These numbers will receive new-order WhatsApp alerts when the app uses 'admin' as the recipient.
# Example: +97455551234,+97455552345
WHATSAPP_ADMIN_RECIPIENTS=+97530078915,+97451015570,+97450055953,+97430736995,+974571342310,+97466082223,+97433292711
