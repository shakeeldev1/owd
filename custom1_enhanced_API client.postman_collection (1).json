		{
			"name": "Text Message",
			"item": [
				{
					"name": "send text message",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Pre-request Script\r",
									"const randomString = (length) => {\r",
									"  const charset = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789';\r",
									"  let result = '';\r",
									"  for (let i = 0; i < length; i++) {\r",
									"    const randomIndex = Math.floor(Math.random() * charset.length);\r",
									"    result += charset[randomIndex];\r",
									"  }\r",
									"  return result;\r",
									"};\r",
									"\r",
									"// Generate a 10-character random string\r",
									"const generatedString = randomString(5);\r",
									"\r",
									"// Set the generatedString as a global variable\r",
									"pm.globals.set(\"generatedString\", generatedString);"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": " {\r\n          \"api_key\": \"{{api_key}}\",\r\n          \"sender\": \"{{sender}}\",\r\n          \"number\": \"{{number}}\",\r\n          \"message\": \"Hi this is {{generatedString}}\"\r\n        }",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{local_base_url}}/send-message",
							"host": [
								"{{local_base_url}}"
							],
							"path": [
								"send-message"
							]
						}
					},
					"response": []
				}
			]
		},
