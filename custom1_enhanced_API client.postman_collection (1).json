		{
			"name": "QR",
			"item": [
				{
					"name": "Get Qrcode",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Check if the \"qrcode\" key exists in the response JSON\r",
									"if (pm.response.json().hasOwnProperty('qrcode')) {\r",
									"  // Get the base64-encoded image from the response\r",
									"  const imageBase64 = pm.response.json().qrcode.split(\",\")[1];\r",
									"\r",
									"  // Create a data URI with the base64 image\r",
									"  const dataURI = \"data:image/png;base64,\" + imageBase64;\r",
									"\r",
									"  // Create an HTML template to display the image\r",
									"  const template = `<img src=\"${dataURI}\" style=\"width:150px;height:150px;\"/>`;\r",
									"\r",
									"  // Set the visualizer to display the image\r",
									"  pm.visualizer.set(template);\r",
									"} else {\r",
									"  // If \"qrcode\" key is not present, do something else or leave it blank\r",
									"  // For example, you can set an empty visualizer:\r",
									"  pm.visualizer.set(\"\");\r",
									"}\r",
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": " {\r\n  \"api_key\": \"{{api_key}}\",\r\n  \"sender\": \"{{sender}}\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{local_base_url}}/generate-qr",
							"host": [
								"{{local_base_url}}"
							],
							"path": [
								"generate-qr"
							]
						}
					},
					"response": []
				},
